    "## 2. Warm-up: frequency discrimination\n",
    "\n",
    "Before MNIST, a task oscillators should be *good* at: classify which of three frequencies\n",
    "(15 / 30 / 60 Hz) a noisy sinusoid carries. Random phase per example, so the answer cannot come\n",
    "from a fixed time offset.\n",
    "\n",
    "If a bank of resonators cannot do this, nothing downstream is worth debugging."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "01593ea6",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1980x704 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "usable band 0.5-100.0 Hz; all three classes sit inside it\n"
     ]
    }
   ],
   "source": [
    "L_F, DT_F = 2000, 1e-3                   # sequence length and time step for frequency discrimination task  \n",
    "F_LO, F_HI = usable_band(L_F, DT_F)      \n",
    "CLASSES = jnp.array([8.0, 32.0, 80.0])     # frequencies in Hz, all inside the usable band\n",
    "\n",
    "def freq_batch(key, n, noise=0.3):\n",
    "    \"\"\"Noisy sinusoid at one of CLASSES, random phase. -> (L, n, 1), (n,)\"\"\"\n",
    "    k1, k2, k3 = jax.random.split(key, 3)\n",
    "    y = jax.random.randint(k1, (n,), 0, len(CLASSES))\n",
    "    phase = jax.random.uniform(k2, (n,)) * 2 * jnp.pi\n",
    "    t = jnp.arange(1, L_F + 1) * DT_F\n",
    "    f = CLASSES[y]\n",
    "    x = jnp.sin(2 * jnp.pi * f[None, :] * t[:, None] + phase[None, :])\n",
    "    x = x + noise * jax.random.normal(k3, (L_F, n))\n",
    "    return x[..., None], y\n",
    "\n",
    "xb, yb = freq_batch(jax.random.PRNGKey(0), 3)\n",
    "fig, ax = plt.subplots(3, 1, figsize=(9, 3.2), sharex=True)\n",
    "for i in range(3):\n",
    "    ax[i].plot(np.arange(L_F) * DT_F, np.asarray(xb[:, i, 0]), lw=0.9, color=f\"C{i}\")\n",
    "    ax[i].set_ylabel(f\"{float(CLASSES[yb[i]]):.0f} Hz\", fontsize=8)\n",
    "ax[-1].set_xlabel(\"time (s)\")\n",
    "fig.suptitle(\"Frequency-discrimination task (3 examples)\", fontsize=10)\n",
    "plt.tight_layout(); plt.show()\n",
    "print(f\"usable band {F_LO:.1f}-{F_HI:.1f} Hz; all three classes sit inside it\")"
   ]
  },
